/**
 * discord-ai GAS bridge — Phase 1 connection test endpoint.
 *
 * Deploy as a Web app, then set Script Property DISCORD_AI_SECRET
 * to the one-time secret generated by /gas connect.
 * Execute as the script owner. Access: Anyone.
 *
 * Phase 1 intentionally accepts system.ping only.
 */
function doPost(e) {
  try {
    var request = JSON.parse((e && e.postData && e.postData.contents) || "{}");
    var secret = PropertiesService.getScriptProperties().getProperty("DISCORD_AI_SECRET");
    if (!secret || !verifyRequest_(request, secret)) {
      return jsonOutput_({ ok: false, error: "unauthorized" });
    }
    if (request.action !== "system.ping") {
      return jsonOutput_({
        ok: false, request_id: request.request_id || null, error: "unsupported_action"
      });
    }
    return jsonOutput_({
      ok: true,
      request_id: request.request_id,
      action: request.action,
      result: {
        service: "discord-ai-gas",
        status: "ok",
        timestamp: Math.floor(Date.now() / 1000)
      }
    });
  } catch (error) {
    console.error("discord-ai GAS request failed", error);
    return jsonOutput_({ ok: false, error: "invalid_request" });
  }
}

function verifyRequest_(request, secret) {
  if (!request || request.version !== 1 ||
      typeof request.request_id !== "string" ||
      !/^[A-Za-z0-9-]{16,80}$/.test(request.request_id) ||
      typeof request.nonce !== "string" ||
      !/^[A-Za-z0-9_-]{20,80}$/.test(request.nonce) ||
      typeof request.timestamp !== "number" ||
      Math.abs(Math.floor(Date.now() / 1000) - request.timestamp) > 300 ||
      typeof request.action !== "string" ||
      !request.payload || typeof request.payload !== "object" ||
      Array.isArray(request.payload) ||
      typeof request.signature !== "string") {
    return false;
  }

  var lock = LockService.getScriptLock();
  lock.waitLock(10000);
  try {
    var props = PropertiesService.getScriptProperties();
    var all = props.getProperties();
    var now = Math.floor(Date.now() / 1000);
    Object.keys(all).forEach(function(key) {
      if (key.indexOf("discord_ai_nonce_") === 0 && now - Number(all[key]) > 600) {
        props.deleteProperty(key);
      }
    });
    var nonceKey = "discord_ai_nonce_" + request.nonce;
    if (props.getProperty(nonceKey)) return false;

    var canonical = [
      request.version, request.timestamp, request.nonce, request.request_id,
      request.action, JSON.stringify(request.payload || {})
    ].join("\n");
    var digest = Utilities.computeHmacSha256Signature(canonical, secret);
    var expected = digest.map(function(byte) {
      return ("0" + ((byte + 256) % 256).toString(16)).slice(-2);
    }).join("");
    if (!constantTimeEqual_(expected, request.signature.toLowerCase())) return false;

    props.setProperty(nonceKey, String(now));
    return true;
  } finally {
    lock.releaseLock();
  }
}

function constantTimeEqual_(a, b) {
  if (typeof a !== "string" || typeof b !== "string" || a.length !== b.length) return false;
  var diff = 0;
  for (var i = 0; i < a.length; i++) diff |= a.charCodeAt(i) ^ b.charCodeAt(i);
  return diff === 0;
}

function jsonOutput_(value) {
  return ContentService.createTextOutput(JSON.stringify(value))
    .setMimeType(ContentService.MimeType.JSON);
}
